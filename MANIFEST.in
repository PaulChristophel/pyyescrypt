include LICENSE
include README.md
include pyproject.toml
include setup.py
include go.mod
include go.sum

recursive-include capi *.go
recursive-include cmd *.go
recursive-include internal *.go
recursive-include src/pyyescrypt *.py
recursive-include tests *.py

# Source distributions rebuild native artifacts for the destination platform.
global-exclude *.so *.dylib *.dll *.h *.exe pyyescrypt-cli
